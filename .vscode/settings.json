{
  "terminal.integrated.defaultProfile.windows": "Ubuntu-24.04",
  "terminal.integrated.profiles.windows": {
    "Ubuntu-24.04": {
      "path": "wsl.exe",
      "args": ["-d", "Ubuntu-24.04", "--cd", "/mnt/c/Users/kamag/Documents/AWS"]
    }
  },
  // エージェント／タスク用シェルも WSL 固定（毎回 wsl -c で包まないための設定）
  // 効かない場合は Cursor Settings → Agents → Legacy Terminal Tool を ON にして再起動
  "terminal.integrated.automationProfile.windows": {
    "path": "wsl.exe",
    "args": ["-d", "Ubuntu-24.04", "--cd", "/mnt/c/Users/kamag/Documents/AWS"]
  },
  // Markdown は標準プレビュー（vscode.markdown.preview.editor）を既定にする。
  // Cursor 独自の WYSIWYG（workbench.editor.markdown）や Markdown for Humans に奪われないようにする。
  // - [ ] の見た目は拡張 bierner.markdown-checkbox がプレビューに追加する（推奨: extensions.json）
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor",
    "*.markdown": "vscode.markdown.preview.editor"
  }
}
